# =========================================================
# ABC Bot Paper Trader — example environment file
# ---------------------------------------------------------
# Copy to `.env` for local overrides and NEVER commit `.env`.
# All values below are safe, non-credential defaults.
# =========================================================

# Runtime environment: development | test | production
ABC_BOT_ENV=development

# Collector mode (only PAPER_DATA_ONLY is supported)
ABC_BOT_MODE=PAPER_DATA_ONLY

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
ABC_BOT_LOG_LEVEL=INFO

# Storage paths (relative to repository root)
ABC_BOT_DATA_DIR=./data
ABC_BOT_SQLITE_DIR=./data/sqlite
ABC_BOT_EVENTS_DIR=./data/events
ABC_BOT_ANALYTICS_DIR=./data/analytics

# =========================================================
# SAFETY — NOT CONFIGURABLE BY DESIGN
# ---------------------------------------------------------
#  - live trading is forbidden in this repository
#  - read-only mode is always ON
#  - demo execution is always disabled
#  - collector mode is always PAPER_DATA_ONLY
#
# Do NOT add broker / account credentials here. There are no
# credentials to configure: this repository never connects to
# HFM, MT5, or any demo/live account.
# =========================================================